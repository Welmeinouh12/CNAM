# Sans DATABASE_URL, le projet utilise SQLite (db.sqlite3) en local.
# Pour tester PostgreSQL localement, définissez aussi DATABASE_URL ici.
# Ne commitez jamais une URL contenant un mot de passe.
# DATABASE_URL=postgresql://USER:MOT_DE_PASSE@HOST:5432/postgres

# Nom de la table des assurés. « assure » si elle a été créée au singulier.
CNAM_ASSURES_TABLE=assure


# ===========================================================================
# VARIABLES POUR LE DÉPLOIEMENT VERCEL + SUPABASE
# ===========================================================================
# Ces variables se déclarent dans Vercel :
#   Settings > Environment Variables
# Ne jamais coller de valeur sensible dans ce fichier.
#
# 1) SECRET_KEY  (OBLIGATOIRE)
#    Générer une valeur aléatoire :
#      python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# 2) DATABASE_URL  (OBLIGATOIRE)
#    Supabase > Project Settings > Database > Connection string.
#    Si PostgreSQL est activé, choisir de préférence « Session pooler »
#    (port 5432) plutôt que « Transaction pooler », plus compatible avec Django.
#    Format : postgresql://USER:MOT_DE_PASSE@HOST:5432/postgres
#
# 3) DEBUG=False  (OBLIGATOIRE en production)
#
# 4) CNAM_ASSURES_TABLE=assure
#    Doit correspondre au nom réel de votre table dans Supabase.
#
# Optionnel (des valeurs par défaut adaptées sont déjà prévues) :
#   ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, MEDIA_ROOT, CNAM_ASSURES_TABLE.


# ===========================================================================
# VARIABLES POUR LE DÉPLOIEMENT VERCEL
# ===========================================================================
# Ces variables ne sont PAS à remplir ici : elles se déclarent dans
# Settings > Environment Variables du projet Vercel.
# Ne jamais committer de valeur sensible dans ce fichier.
# ===========================================================================

# OBLIGATOIRE — Vercel la fournit siquement pour le déploiement.
# Générer une valeur aléatoire :
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# SECRET_KEY=

# OBLIGATOIRE en production — Django refuse d'afficher ses pages d'erreur
# détaillées si les hôtes ne sont pas déclarés. « .vercel.app » couvre à la
# fois le domaine de production et les domaines d'aperçu.
# ALLOWED_HOSTS=.vercel.app

# Recommandé — passer en False dès la mise en ligne.
# DEBUG=False

# Connexion à la base. Sur Vercel + Supabase, la façon la plus simple est de
# coller le « Connection string » fourni par Supabase (il vaut mieux choisir
# le « Session pooler » si PostgreSQL est activé) :
#     DATABASE_URL=postgresql://USER:MOT_DE_PASSE@HOST:5432/postgres
#
# Renseignée automatiquement pour les bases Vercel/Supabase reliées au projet.
# À ne coller que dans les variables d'environnement Vercel.
# DATABASE_URL=
#
# CNAM_DB_ENGINE n'a pas besoin d'être défini : PostgreSQL est sélectionné
# automatiquement dès que DATABASE_URL est présente.
